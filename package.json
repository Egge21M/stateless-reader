{
  "name": "stateless-reader",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @stateless-reader/reader dev",
    "start": "bun run --filter @stateless-reader/reader start",
    "build": "bun run --workspaces --if-present build",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
