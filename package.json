{
  "name": "stateless-reader",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @stateless-reader/reader dev",
    "dev:frontend": "bun run --filter @stateless-reader/frontend dev",
    "dev:backend": "bun run --filter @stateless-reader/backend dev",
    "start:backend": "bun run --filter @stateless-reader/backend start",
    "db:generate": "bun run --filter @stateless-reader/backend db:generate",
    "db:migrate": "bun run --filter @stateless-reader/backend db:migrate",
    "start": "bun run --filter @stateless-reader/reader start",
    "build": "bun run --workspaces --if-present build",
    "lint": "bun run --workspaces --if-present lint",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun test --pass-with-no-tests",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@cashu/cashu-ts": "5.0.0-rc.4",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/pngjs": "6.0.5",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2"
  }
}
