HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data.sqlite
# Trusted HTTPS origin for NUT-18 payment transport URLs; required behind a proxy.
# Omit only for loopback development. Never derived from request Host headers.
# PUBLIC_ORIGIN=https://publisher.example
COCO_DATABASE_PATH=./coco.sqlite
# REQUIRED: privately provision one stable 64-byte publisher seed as 128 hex characters.
# Keep it across restarts and back it up with both databases. Never use a reader phrase.
# No seed value is supplied here; startup fails safely until configured.
# PUBLISHER_SEED_HEX=
